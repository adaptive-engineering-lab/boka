# Copy to .env.local and fill in. NEVER commit a filled-in copy — .gitignore covers it.

# --- Supabase: safe to expose in the browser ---
# Subject to RLS, so shipping it to the client is fine and expected.
# Supabase renamed this from "anon key" to "publishable key"; either variable name
# works, so you do not need to rename a working one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # accepted alternative

# --- Supabase: SERVER ONLY ---
# This key bypasses Row Level Security completely, and RLS is where every privacy
# guarantee in this project lives (Principle II). If it reaches a client bundle,
# anyone can read every draft design, every private note, and every inquiry.
# Never prefix it with NEXT_PUBLIC_. Import only via lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Inquiry notifications (FR-039) ---
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=

# --- Rate limiting (FR-041, research D7) ---
# Salt for hashing visitor IPs. Any long random string. Changing it resets all
# in-flight rate-limit windows, which is harmless.
#
# REQUIRED IN PRODUCTION. Optional locally, where the per-process random fallback merely
# resets the counting window on restart. On a serverless host it does more than degrade the
# limit — it removes it: each Lambda instance salts differently, so a visitor's requests hash
# to different senders, the count never accumulates, and FR-041 / SC-016 stop being enforced
# with nothing visibly broken. The app logs an error and keeps accepting inquiries rather than
# refusing them (FR-040), so this will not announce itself any other way.
RATE_LIMIT_SALT=

# --- Image delivery (FR-009a) ---
# Nothing to configure. Images are served by the application itself: /img re-checks
# publication on every request, then reads the object and returns resized bytes.
#
# There was an IMAGE_SIGNED_URL_TTL_SECONDS setting here. It is gone because signed URLs
# are gone (research D11, as amended) — an issued signature kept working for its lifetime
# even after the design behind it was unpublished, and that residual window was the only
# thing the variable controlled.
